# Groq — LLM provider (https://console.groq.com/keys)
GROQ_API_KEY=
# Model used for answers. gpt-oss-120b: strong tool use, ~500 tok/s.
GROQ_MODEL=openai/gpt-oss-120b

# Tavily — web search (https://app.tavily.com)
TAVILY_API_KEY=

# --- Optional ---
# Smaller model that extracts facts ("claims") from answers in the background.
# CLAIMS_MODEL=openai/gpt-oss-20b
# Print per-turn timings and token counts to the server console.
# LOG_TIMINGS=1
# Pretend the server started at this moment (demo multi-day memory).
# NOW=2026-11-09T05:30:00Z
# Used when the main model hits its daily token limit (Groq limits are per model).
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
